PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/workplace_db
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/workplace_db?retryWrites=true&w=majority
REDIS_URL=redis://127.0.0.1:6379
# Or Upstash Redis / Redis Cloud:
# REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development
